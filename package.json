{
  "name": "rollcall-kitchen",
  "version": "1.0.0",
  "description": "RollCall Kitchen — Authentic Kathi Rolls, Kebabs & Bobba. A modular, PostgreSQL-backed Node.js/Express website.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "pg": "^8.12.0",
    "resend": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
