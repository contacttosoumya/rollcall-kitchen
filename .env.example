# Copy this file to .env and fill in real values for your environment.
# Nothing here is loaded automatically in production unless you set these
# as real environment variables (Docker, PM2, your host's dashboard, etc).

NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# --- Database -----------------------------------------------------------
# Either set DATABASE_URL (takes priority)...
# DATABASE_URL=postgres://user:password@host:5432/tadka_street
# ...or the discrete PG* vars below:
PGHOST=localhost
PGPORT=5432
PGDATABASE=tadka_street
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# Connection pool sizing — see README "Scaling" section for guidance.
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# --- Caching --------------------------------------------------------------
CACHE_TTL_SECONDS=120
CACHE_CHECK_PERIOD_SECONDS=60

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=600
RATE_LIMIT_MAX_WRITE=20

LOG_LEVEL=debug
