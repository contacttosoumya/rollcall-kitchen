<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="page-locations">
<%- include('partials/header') %>

<% const locHero = (content.page_heroes && content.page_heroes.locations) || {}; %>

<main>
  <section class="page-hero page-hero--locations">
    <div class="wrap">
      <% if (locHero.eyebrow) { %><p class="eyebrow eyebrow--light" data-reveal><%= locHero.eyebrow %></p><% } %>
      <h1 class="light-heading" data-reveal><%= locHero.title || 'Find RollCall Kitchen.' %></h1>
      <p class="page-hero__sub" data-reveal data-reveal-delay="1"><%= locHero.subtitle || '' %></p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap locations-list">
      <% locations.forEach(function(loc, i){ %>
        <article class="location-detail" id="<%= loc.slug %>" data-reveal data-reveal-delay="<%= i % 2 %>">
 <div class="location-detail__map" aria-hidden="true">
  <% if (loc.mapUrl) { %>
    <img src="<%= loc.mapUrl %>" alt="" loading="lazy">
  <% } else { %>
  <%- include('partials/grand-opening-graphic') %>
  <% } %>
</div>
          <div class="location-detail__body">
            <h2><%= loc.name %></h2>
            <p class="location-detail__address">📍 <%= loc.address %></p>
            <p class="location-detail__phone">📞 <a href="tel:<%= loc.phone.replace(/[^0-9]/g,'') %>"><%= loc.phone %></a></p>

            <% if (loc.hours.length) { %>
            <div class="location-detail__hours">
              <h3>Hours</h3>
              <ul>
                <% loc.hours.forEach(function(h){ %>
                  <li><span><%= h.days %></span><span><%= h.time %></span></li>
                <% }) %>
              </ul>
            </div>
            <% } %>

            <% if (loc.features.length) { %>
            <div class="tag-row">
              <% loc.features.forEach(function(f){ %><span class="tag"><%= f %></span><% }) %>
            </div>
            <% } %>

            <div class="hero__cta">
              <a href="https://maps.google.com/maps?q=<%= encodeURIComponent(loc.mapQuery) %>" target="_blank" rel="noopener" class="btn btn--outline">Get Directions</a>
              <a href="/menu" class="btn btn--primary">Order From <%= loc.name %></a>
            </div>
          </div>
        </article>
      <% }) %>

      <% if (!locations.length) { %>
        <p class="menu-empty">We're between locations right now — check back soon, or <a href="/contact" class="text-link">contact us</a> for updates.</p>
      <% } %>
    </div>
  </section>

  <section class="section section--charcoal">
    <div class="wrap final-cta__inner" data-reveal>
      <h2 class="light-heading">Don't see us in your neighborhood yet?</h2>
      <p class="page-hero__sub">We're expanding across the Carolinas. Tell us what you'd love to see next.</p>
      <a href="/contact" class="btn btn--primary btn--large">Suggest a Location</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js?v=<%= assetVersion %>"></script>
</body>
</html>