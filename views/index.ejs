<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="page-home">
<%- include('partials/header') %>

<% const hero = content.hero_home || {}; %>
<% const homeAbout = content.home_about_split || {}; %>
<% const trustStats = content.trust_stats || []; %>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__blob hero__blob--1"></div>
      <div class="hero__blob hero__blob--2"></div>
      <svg class="hero__steam" width="120" height="200" viewBox="0 0 120 200" aria-hidden="true">
        <path d="M20 200C20 160 50 160 50 120C50 80 20 80 20 40" stroke="white" stroke-opacity=".18" stroke-width="6" stroke-linecap="round" fill="none"/>
        <path d="M70 200C70 170 100 170 100 130C100 90 70 90 70 50" stroke="white" stroke-opacity=".12" stroke-width="6" stroke-linecap="round" fill="none"/>
      </svg>
    </div>
    <div class="wrap hero__inner">
      <div class="hero__copy" data-reveal>
        <% if (hero.eyebrow) { %><p class="eyebrow eyebrow--light"><%= hero.eyebrow %></p><% } %>
        <h1 class="hero__title">
          <%= hero.title_line1 || 'Street food that' %><br>
          <span class="hero__title-accent"><%= hero.title_accent || 'hits different.' %></span>
        </h1>
        <p class="hero__sub"><%= hero.subtitle || '' %></p>
        <div class="hero__cta">
          <a href="/menu" class="btn btn--primary btn--large">View The Menu</a>
          <a href="/locations" class="btn btn--outline btn--large">Find a Location</a>
        </div>
        <% if ((hero.meta_badges || []).length) { %>
        <div class="hero__meta">
          <% hero.meta_badges.forEach(function(m){ %><span><%= m %></span><% }) %>
        </div>
        <% } %>
      </div>

      <div class="hero__visual" data-reveal data-reveal-delay="1">
        <img class="hero__mascot" src="/images/logo-mascot.png" alt="RollCall Kitchen — Authentic Kathi Rolls">
        <% if (heroDish) { %>
        <div class="hero__ticket">
          <div class="ticket">
            <div class="ticket__hole"></div>
            <p class="ticket__eyebrow">Today's Special</p>
            <h3 class="ticket__title"><%= heroDish.name %></h3>
            <p class="ticket__desc"><%= heroDish.description %></p>
            <div class="ticket__row">
              <span class="spice-meter" aria-label="Spice level">
                <% for(let s=1;s<=3;s++){ %><span class="spice-flame <%= s<=heroDish.spice ? 'is-lit':'' %>">🔥</span><% } %>
              </span>
              <span class="ticket__price">$<%= heroDish.price.toFixed(2) %></span>
            </div>
            <div class="ticket__edge" aria-hidden="true"></div>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <% if (categories.length) { %>
    <div class="hero__categories" data-reveal>
      <div class="wrap">
        <div class="chip-row" id="homeCategoryChips">
          <% categories.forEach(function(c){ %>
            <a class="chip" href="/menu#<%= c.slug %>"><span><%= c.icon %></span><%= c.label %></a>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>
  </section>

  <!-- TRUST BAR -->
  <% if (trustStats.length) { %>
  <section class="trust-bar">
    <div class="wrap trust-bar__grid">
      <% trustStats.forEach(function(stat){ %>
        <div class="trust-stat">
          <span class="trust-stat__num" data-target="<%= stat.target %>"><%= stat.target.toLocaleString() %><%= stat.target >= 1000 ? '+' : '' %></span>
          <span class="trust-stat__label"><%= stat.label %></span>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- SIGNATURE / BESTSELLERS -->
  <% if (featured.length) { %>
  <section class="section section--cream" id="favorites">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Crowd Favorites</p>
        <h2>The dishes people drive across town for.</h2>
        <a href="/menu" class="text-link">See the full menu →</a>
      </div>

      <div class="dish-grid">
        <% const swatches = ['sw-chili','sw-marigold','sw-curry','sw-maroon','sw-chili','sw-curry']; %>
        <% featured.forEach(function(d, i){ %>
          <article class="dish-card" data-reveal data-reveal-delay="<%= i % 3 %>">
            <div class="dish-card__art <%= swatches[i % swatches.length] %>">
              <span class="dish-card__veg <%= d.veg ? 'is-veg' : 'is-nonveg' %>" title="<%= d.veg ? 'Vegetarian' : 'Non-Vegetarian' %>"></span>
              <span class="dish-card__icon"><%= d.icon || d.categoryIcon %></span>
              <span class="dish-card__badge">Bestseller</span>
            </div>
            <div class="dish-card__body">
              <div class="dish-card__row">
                <h3><%= d.name %></h3>
                <span class="dish-card__price">$<%= d.price.toFixed(2) %></span>
              </div>
              <p><%= d.description %></p>
              <div class="dish-card__foot">
                <span class="spice-meter" aria-label="Spice level">
                  <% for(let s=1;s<=3;s++){ %><span class="spice-flame <%= s<=d.spice ? 'is-lit':'' %>">🔥</span><% } %>
                </span>
                <button class="btn btn--tiny btn--primary add-to-tiffin" data-id="<%= d.slug %>" data-name="<%= d.name %>" data-price="<%= d.price %>">Add +</button>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- BUILD YOUR TIFFIN TEASER -->
  <section class="section section--charcoal builder-teaser">
    <div class="wrap builder-teaser__grid">
      <div data-reveal>
        <p class="eyebrow eyebrow--light">Only at RollCall Kitchen</p>
        <h2 class="light-heading">Build your own order, roll by roll.</h2>
        <p class="builder-teaser__copy">Mix chaat, curry, rice & dessert into one order — watch your total add up live, right on the menu page. It's how we've always ordered street food, just faster.</p>
        <a href="/menu" class="btn btn--primary btn--large">Start Building →</a>
      </div>
      <div class="builder-teaser__visual" data-reveal data-reveal-delay="1" aria-hidden="true">
        <div class="tiffin-stack">
          <div class="tiffin-tier tiffin-tier--1"><span>🍛</span></div>
          <div class="tiffin-tier tiffin-tier--2"><span>🥟</span></div>
          <div class="tiffin-tier tiffin-tier--3"><span>🍮</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT SPLIT -->
  <section class="section section--cream about-split">
    <div class="wrap about-split__grid">
      <div class="about-split__art" data-reveal aria-hidden="true">
        <svg viewBox="0 0 400 400" width="100%" height="100%">
          <circle cx="200" cy="200" r="190" fill="var(--marigold-soft)"/>
          <circle cx="200" cy="150" r="60" fill="var(--chili)"/>
          <rect x="100" y="230" width="200" height="110" rx="18" fill="var(--curry)"/>
          <rect x="100" y="230" width="200" height="22" rx="10" fill="var(--curry-deep)"/>
          <circle cx="150" cy="150" r="10" fill="var(--marigold)"/>
          <circle cx="250" cy="150" r="10" fill="var(--marigold)"/>
          <path d="M175 165q25 20 50 0" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" fill="none"/>
        </svg>
      </div>
      <div data-reveal data-reveal-delay="1">
        <% if (homeAbout.eyebrow) { %><p class="eyebrow"><%= homeAbout.eyebrow %></p><% } %>
        <h2><%= homeAbout.heading || '' %></h2>
        <p><%= homeAbout.body || '' %></p>
        <% if ((homeAbout.checklist || []).length) { %>
        <ul class="checklist">
          <% homeAbout.checklist.forEach(function(item){ %><li><%= item %></li><% }) %>
        </ul>
        <% } %>
        <a href="/about" class="text-link">Read our full story →</a>
      </div>
    </div>
  </section>

  <!-- REWARDS TEASER -->
  <section class="section rewards-teaser">
    <div class="wrap rewards-teaser__inner" data-reveal>
      <div class="rewards-teaser__badge" aria-hidden="true">🏅</div>
      <div class="rewards-teaser__copy">
        <p class="eyebrow eyebrow--light">RollCall Rewards</p>
        <h2 class="light-heading">Every order earns points. Every 10th roll is on us.</h2>
        <p>Sign up in 30 seconds and start earning toward free samosas, a birthday biryani, and first access to new menu drops.</p>
      </div>
      <a href="/rewards" class="btn btn--primary btn--large">Join Free</a>
    </div>
  </section>

  <!-- VISIT US SPOTLIGHT (single real location) -->
  <% if (locations.length) { %>
  <% const spotlight = locations[0]; %>
  <section class="section section--cream visit-spotlight">
    <div class="wrap visit-spotlight__grid">
      <div data-reveal>
        <p class="eyebrow">Come Say Hi</p>
        <h2>Visit RollCall Kitchen</h2>
        <p class="visit-spotlight__addr-line">📍 <%= spotlight.address %></p>
        <% if (spotlight.hours.length) { %>
        <ul class="visit-spotlight__hours">
          <% spotlight.hours.forEach(function(h){ %>
            <li><span><%= h.days %></span><span><%= h.time %></span></li>
          <% }) %>
        </ul>
        <% } %>
        <div class="hero__cta">
          <a href="https://maps.google.com/maps?q=<%= encodeURIComponent(spotlight.mapQuery) %>" target="_blank" rel="noopener" class="btn btn--primary">Get Directions</a>
          <a href="tel:<%= spotlight.phone.replace(/[^0-9]/g,'') %>" class="btn btn--outline">Call <%= spotlight.phone %></a>
        </div>
      </div>
      <div class="visit-spotlight__map" data-reveal data-reveal-delay="1" aria-hidden="true">
        <svg viewBox="0 0 400 320" width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
          <rect width="400" height="320" fill="var(--paper-dim)"/>
          <!-- stylized street grid, no third-party map data -->
          <path d="M-10 60 L420 40" stroke="var(--line)" stroke-width="10" fill="none"/>
          <path d="M-10 180 L420 195" stroke="var(--line)" stroke-width="14" fill="none"/>
          <path d="M-10 280 L420 265" stroke="var(--line)" stroke-width="8" fill="none"/>
          <path d="M60 -10 L90 330" stroke="var(--line)" stroke-width="9" fill="none"/>
          <path d="M300 -10 L280 330" stroke="var(--line)" stroke-width="9" fill="none"/>
          <!-- generic unlabeled building blocks -->
          <rect x="110" y="80" width="46" height="34" rx="4" fill="var(--paper)" opacity=".8"/>
          <rect x="190" y="220" width="52" height="38" rx="4" fill="var(--paper)" opacity=".8"/>
          <rect x="30" y="200" width="40" height="30" rx="4" fill="var(--paper)" opacity=".8"/>
          <!-- pin marker -->
          <g transform="translate(200,150)">
            <ellipse cx="0" cy="58" rx="22" ry="6" fill="#000" opacity=".12"/>
            <path d="M0 -46C-24 -46 -40 -28 -40 -6c0 30 40 64 40 64s40-34 40-64c0-22-16-40-40-40Z" fill="var(--chili)"/>
            <circle cx="0" cy="-6" r="16" fill="var(--paper)"/>
            <text x="0" y="5" text-anchor="middle" font-family="Georgia, serif" font-weight="bold" font-size="15" fill="var(--chili)">RC</text>
          </g>
        </svg>
      </div>
    </div>
  </section>
  <% } %>

  <!-- TESTIMONIALS -->
  <% if (testimonials.length) { %>
  <section class="section section--charcoal testimonials">
    <div class="wrap">
      <p class="eyebrow eyebrow--light" data-reveal>Happy Customers</p>
      <h2 class="light-heading" data-reveal>Straight from the hearts (and bellies) of our fans.</h2>

      <div class="testimonial-carousel" data-reveal data-reveal-delay="1">
        <div class="testimonial-track" id="testimonialTrack">
          <% testimonials.forEach(function(t){ %>
          <blockquote class="testimonial">
            <p>“<%= t.quote %>”</p>
            <footer>— <%= t.authorName %><%= t.authorDetail ? ', ' + t.authorDetail : '' %></footer>
          </blockquote>
          <% }) %>
        </div>
        <div class="testimonial-dots" id="testimonialDots"></div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- GALLERY -->
  <% if (gallery.length) { %>
  <section class="section section--cream gallery">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">#RollCallKitchen</p>
        <h2>Scroll through the flavor.</h2>
      </div>
      <div class="gallery-grid" id="galleryGrid">
        <% gallery.forEach(function(t){ %>
          <button class="gallery-tile <%= t.swatch %>" data-lightbox>
            <span><%= t.icon %></span>
          </button>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="wrap final-cta__inner" data-reveal>
      <h2>Hungry yet? Your order is one tap away.</h2>
      <div class="hero__cta">
        <a href="/menu" class="btn btn--primary btn--large">Order Online</a>
        <a href="/catering" class="btn btn--outline-light btn--large">Book Catering</a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>