<!--
  Grand Opening graphic — shown wherever a real map isn't configured
  (GOOGLE_MAPS_API_KEY unset). Deliberately festive rather than trying to
  look like a map: rich brand-color gradient, confetti, and a ribbon
  banner, celebrating the upcoming opening instead of showing a fake or
  empty map. Uses the same CSS custom properties (colors, fonts) as the
  rest of the site, so it always matches the live theme automatically.
-->
<svg viewBox="0 0 400 320" width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="goBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--marigold-deep)"/>
      <stop offset="55%" stop-color="var(--chili)"/>
      <stop offset="100%" stop-color="var(--maroon)"/>
    </linearGradient>
  </defs>

  <rect width="400" height="320" fill="url(#goBg)"/>

  <!-- soft glow behind the ribbon -->
  <circle cx="200" cy="150" r="150" fill="#fff" opacity=".06"/>

  <!-- confetti -->
  <g opacity=".9">
    <circle cx="46" cy="52" r="5" fill="var(--marigold-soft)"/>
    <circle cx="88" cy="30" r="3.5" fill="var(--curry-soft)"/>
    <rect x="120" y="46" width="9" height="9" rx="2" fill="var(--paper)" opacity=".8" transform="rotate(18 124 50)"/>
    <circle cx="330" cy="48" r="4.5" fill="var(--marigold-soft)"/>
    <rect x="352" y="70" width="8" height="8" rx="2" fill="var(--curry-soft)" transform="rotate(-14 356 74)"/>
    <circle cx="300" cy="34" r="3" fill="var(--paper)" opacity=".7"/>
    <circle cx="30" cy="230" r="4" fill="var(--marigold-soft)"/>
    <rect x="20" y="260" width="8" height="8" rx="2" fill="var(--paper)" opacity=".7" transform="rotate(10 24 264)"/>
    <circle cx="368" cy="240" r="5" fill="var(--curry-soft)"/>
    <rect x="340" y="268" width="9" height="9" rx="2" fill="var(--marigold-soft)" transform="rotate(-20 344 272)"/>
    <circle cx="62" cy="280" r="3.5" fill="var(--paper)" opacity=".7"/>
    <circle cx="378" cy="150" r="3.5" fill="var(--paper)" opacity=".6"/>
  </g>

  <!-- pin, matching the brand mark used elsewhere -->
  <g transform="translate(200,118)">
    <ellipse cx="0" cy="46" rx="20" ry="5" fill="#000" opacity=".14"/>
    <path d="M0 -38C-20 -38 -33 -23 -33 -5c0 25 33 53 33 53s33-28 33-53c0-18-13-33-33-33Z" fill="var(--paper)"/>
    <circle cx="0" cy="-5" r="13" fill="var(--chili)"/>
    <text x="0" y="0" text-anchor="middle" font-family="var(--font-display), Georgia, serif" font-weight="400" font-size="12" fill="var(--paper)">RC</text>
  </g>

  <!-- ribbon banner -->
  <g transform="translate(200,204)">
    <path d="M-150 -20 L-130 0 L-150 20 L150 20 L130 0 L150 -20 Z" fill="var(--paper)"/>
    <path d="M-150 -20 L-130 0 L-150 20 Z" fill="var(--maroon)" opacity=".35"/>
    <path d="M150 -20 L130 0 L150 20 Z" fill="var(--maroon)" opacity=".35"/>
    <text x="0" y="7" text-anchor="middle" font-family="var(--font-display), Georgia, serif" font-weight="400" font-size="25" letter-spacing="1" fill="var(--chili)">GRAND OPENING</text>
  </g>

  <text x="200" y="258" text-anchor="middle" font-family="var(--font-mono), monospace" font-weight="700" font-size="12" letter-spacing="2" fill="var(--marigold-soft)">ROLLCALL KITCHEN</text>
</svg>