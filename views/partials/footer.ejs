<section class="newsletter">
  <div class="wrap newsletter__inner">
    <div>
      <p class="eyebrow eyebrow--light">Stay in the loop</p>
      <h2>Get 10% off your first online order</h2>
      <p class="newsletter__sub">New menu drops, secret specials & rewards perks — straight to your inbox. No spam, just spice.</p>
    </div>
    <form class="newsletter__form" id="newsletterForm">
      <label for="newsletterEmail" class="sr-only">Email address</label>
      <input type="email" id="newsletterEmail" name="email" placeholder="you@email.com" required>
      <button type="submit" class="btn btn--primary">Sign Me Up</button>
    </form>
    <p class="newsletter__msg" id="newsletterMsg" role="status" aria-live="polite"></p>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand brand--footer">
        <span class="brand__mark" aria-hidden="true">
          <img src="/images/logo-badge.png" alt="" width="40" height="40">
        </span>
        <span class="brand__name">RollCall<em>Kitchen</em></span>
      </a>
      <p>Authentic kathi rolls, kebabs & bobba — rolled fresh, served hot, in Charlotte, NC.</p>
      <% if (site.address) { %>
      <p class="footer-address">
        <a href="https://maps.google.com/maps?q=<%= encodeURIComponent(site.address) %>" target="_blank" rel="noopener">📍 <%= site.address %></a>
      </p>
      <% } %>
      <div class="social-row">
        <a href="<%= site.instagram %>" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
        </a>
        <a href="<%= site.facebook %>" aria-label="Facebook" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M14 21v-7h2.5l.5-3H14V9c0-.9.3-1.5 1.7-1.5H17V4.8c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1V11H8v3h2.6v7H14Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        </a>
        <% if (site.whatsapp && site.whatsapp !== '#') { %>
        <a href="<%= site.whatsapp %>" aria-label="Join our WhatsApp group" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.5 8.3c.2-.5.5-.5.7-.5h.5c.2 0 .4 0 .5.3l.7 1.7c.1.2 0 .4-.1.5l-.5.5c-.1.1-.1.3 0 .4.4.7 1.4 1.7 2.1 2.1.1.1.3.1.4 0l.5-.5c.1-.1.3-.2.5-.1l1.7.7c.3.1.3.3.3.5v.5c0 .2 0 .5-.5.7-.5.2-1.9.7-3.4-.8s-1-2.9-.8-3.4Z" fill="currentColor"/></svg>
        </a>
        <% } %>
      </div>
    </div>

    <div class="footer-col">
      <h3>Explore</h3>
      <a href="/menu">Full Menu</a>
      <a href="/locations">Locations</a>
      <a href="/rewards">Rewards</a>
      <a href="/catering">Catering &amp; Events</a>
      <a href="/about">Our Story</a>
    </div>

    <div class="footer-col">
      <h3>Get Help</h3>
      <a href="/contact">Contact Us</a>
      <a href="tel:<%= site.phone.replace(/[^0-9]/g,'') %>"><%= site.phone %></a>
      <a href="mailto:<%= site.email %>"><%= site.email %></a>
      <a href="/contact#faq">FAQs</a>
    </div>

    <div class="footer-col">
      <h3>Order On</h3>
      <a href="<%= site.doordash %>" target="_blank" rel="noopener">DoorDash</a>
      <a href="<%= site.ubereats %>" target="_blank" rel="noopener">Uber Eats</a>
      <a href="<%= site.orderUrl %>">Order Direct (Best Price)</a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> <%= site.name %>. All rights reserved.</p>
    <div class="footer-legal">
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Use</a>
      <a href="#">Accessibility</a>
    </div>
  </div>
</footer>

<% if (site.whatsapp && site.whatsapp !== '#') { %>
<a href="<%= site.whatsapp %>" class="whatsapp-float" target="_blank" rel="noopener" aria-label="Join our WhatsApp group">
  <span class="whatsapp-float__label">Join Our WhatsApp Group! 👋</span>
  <span class="whatsapp-float__icon">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.5 8.3c.2-.5.5-.5.7-.5h.5c.2 0 .4 0 .5.3l.7 1.7c.1.2 0 .4-.1.5l-.5.5c-.1.1-.1.3 0 .4.4.7 1.4 1.7 2.1 2.1.1.1.3.1.4 0l.5-.5c.1-.1.3-.2.5-.1l1.7.7c.3.1.3.3.3.5v.5c0 .2 0 .5-.5.7-.5.2-1.9.7-3.4-.8s-1-2.9-.8-3.4Z" fill="currentColor"/></svg>
  </span>
</a>
<% } %>

<button class="back-to-top" id="backToTop" aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 19V5M12 5l-6 6M12 5l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<div class="tiffin-drawer" id="tiffinDrawer" aria-hidden="true">
  <div class="tiffin-drawer__inner">
    <div class="tiffin-drawer__head">
      <h3>Your Order</h3>
      <button id="tiffinClose" aria-label="Close order summary">&times;</button>
    </div>
    <p class="tiffin-drawer__hint">Build your order from the <a href="/menu">menu</a> — it's saved right here as you browse.</p>
    <div class="tiffin-drawer__items" id="tiffinItems"></div>
    <div class="tiffin-drawer__total">
      <span>Subtotal</span>
      <strong id="tiffinTotal">$0.00</strong>
    </div>
    <a href="<%= site.doordash %>" target="_blank" rel="noopener" class="btn btn--primary btn--block">Checkout on DoorDash</a>
    <a href="tel:<%= site.phone.replace(/[^0-9]/g,'') %>" class="btn btn--ghost btn--block">Or Call to Order — <%= site.phone %></a>
  </div>
</div>
<div class="tiffin-backdrop" id="tiffinBackdrop"></div>