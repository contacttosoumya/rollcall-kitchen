<% const comingSoon = (typeof content !== 'undefined' && content.coming_soon_banner) || {}; %>
<% if (comingSoon.enabled) { %>
<div class="coming-soon-banner" id="comingSoonBanner">
  <div class="wrap coming-soon-banner__inner">
    <p class="coming-soon-banner__text">
      <span class="coming-soon-banner__badge">Coming Soon</span>
      <span><%= comingSoon.message || "Something exciting is on the way — stay tuned!" %></span>
      <% if (comingSoon.ctaText && comingSoon.ctaUrl) { %>
        <a href="<%= comingSoon.ctaUrl %>" class="coming-soon-banner__cta"><%= comingSoon.ctaText %></a>
      <% } %>
    </p>
  </div>
</div>
<% } %>

<% const marqueeItems = (typeof content !== 'undefined' && content.marquee_items) ? content.marquee_items : []; %>
<% if (marqueeItems.length) { %>
<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <% for (let r = 0; r < 3; r++) { %>
      <% marqueeItems.forEach(function(item){ %>
        <span class="marquee__item"><%= item %></span>
      <% }) %>
    <% } %>
  </div>
</div>
<% } %>

<header class="site-header" id="siteHeader">
  <% if (site.address) { %>
  <div class="location-strip">
    <div class="wrap location-strip__inner">
      <a class="location-strip__addr" href="https://maps.google.com/maps?q=<%= encodeURIComponent(site.address) %>" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg>
        <span><%= site.address %></span>
        <em>Get Directions</em>
      </a>
    </div>
  </div>
  <% } %>
  <div class="wrap site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark" aria-hidden="true">
        <img src="/images/logo-badge.png" alt="" width="44" height="44">
      </span>
      <span class="brand__text">
        <span class="brand__name">RollCall<em>Kitchen</em></span>
        <span class="brand__tag">Kathi Rolls<br>Kebabs · Bobba</span>
      </span>
    </a>

    <nav class="main-nav" id="mainNav" aria-label="Primary">
      <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a>
      <a href="/menu" class="<%= currentPath === '/menu' ? 'is-active' : '' %>">Menu</a>
      <a href="/locations" class="<%= currentPath === '/locations' ? 'is-active' : '' %>">Locations</a>
      <a href="/catering" class="<%= currentPath === '/catering' ? 'is-active' : '' %>">Catering</a>
      <a href="/rewards" class="<%= currentPath === '/rewards' ? 'is-active' : '' %>">Rewards</a>
      <a href="/about" class="<%= currentPath === '/about' ? 'is-active' : '' %>">Our Story</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'is-active' : '' %>">Contact</a>
    </nav>

    <div class="header-actions">
      <a href="tel:<%= site.phone.replace(/[^0-9]/g,'') %>" class="header-call" aria-label="Call <%= site.name %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.3 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span><%= site.phone %></span>
      </a>
      <button class="btn btn--ghost btn--small nav-cart" id="tiffinToggle" aria-label="View your order">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 8h16l-1.3 10.4a2 2 0 0 1-2 1.6H7.3a2 2 0 0 1-2-1.6L4 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 8V6a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.6"/></svg>
        <span>Order</span>
        <span class="cart-count" id="cartCount">0</span>
      </button>
      <a href="<%= site.orderUrl %>" class="btn btn--primary btn--small header-order-cta">Order Now</a>
      <button class="hamburger" id="hamburgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mainNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>