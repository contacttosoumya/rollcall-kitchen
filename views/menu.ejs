<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="page-menu">
<%- include('partials/header') %>

<% const menuHero = (content.page_heroes && content.page_heroes.menu) || {}; %>

<main>
  <section class="page-hero page-hero--menu">
    <div class="wrap">
      <% if (menuHero.eyebrow) { %><p class="eyebrow eyebrow--light" data-reveal><%= menuHero.eyebrow %></p><% } %>
      <h1 class="light-heading" data-reveal><%= menuHero.title || "Everything's cooked to order." %></h1>
      <p class="page-hero__sub" data-reveal data-reveal-delay="1"><%= menuHero.subtitle || '' %></p>
    </div>
  </section>

  <section class="section section--cream menu-page" id="build-your-tiffin">
    <div class="wrap menu-layout">

      <div class="menu-main">
        <!-- Controls -->
        <div class="menu-controls" data-reveal>
          <div class="menu-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <input type="text" id="menuSearch" placeholder="Search the menu — “biryani”, “paneer”, “chai”…">
          </div>
          <div class="menu-toggles">
            <button class="pill-toggle" id="vegOnlyToggle" data-active="false">
              <span class="dish-card__veg is-veg" style="width:12px;height:12px;display:inline-block;border-width:1.5px;"></span>
              Veg Only
            </button>
            <div class="spice-filter" role="group" aria-label="Filter by spice level">
              <span>Heat:</span>
              <button class="spice-filter__btn is-active" data-spice="all">All</button>
              <button class="spice-filter__btn" data-spice="0">Mild</button>
              <button class="spice-filter__btn" data-spice="2">Medium</button>
              <button class="spice-filter__btn" data-spice="3">🔥 Hot</button>
            </div>
          </div>
        </div>

        <!-- Category tabs -->
        <div class="menu-tabs" id="menuTabs" data-reveal>
          <button class="menu-tab is-active" data-cat="all">All</button>
          <% categories.forEach(function(c){ %>
            <button class="menu-tab" data-cat="<%= c.slug %>"><%= c.icon %> <%= c.label %></button>
          <% }) %>
        </div>

        <p class="menu-empty" id="menuEmpty" hidden>No dishes match those filters — try clearing a filter or searching something else.</p>

        <!-- Sections -->
        <% groupedMenu.forEach(function(cat, catIndex){ %>
          <% if (cat.dishes.length) { %>
          <div class="menu-section" id="<%= cat.slug %>" data-category-section="<%= cat.slug %>">
            <button class="menu-section__head" type="button" aria-expanded="false">
              <span class="menu-section__head-text">
                <h2><%= cat.icon %> <%= cat.label %></h2>
                <p><%= cat.blurb %></p>
              </span>
              <span class="menu-section__meta">
                <span class="menu-section__count"><%= cat.dishes.length %> items</span>
                <svg class="menu-section__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>
            <div class="menu-items" hidden>
              <% cat.dishes.forEach(function(d){ %>
                <article class="menu-item"
                  data-name="<%= d.name.toLowerCase() %>"
                  data-desc="<%= d.description.toLowerCase() %>"
                  data-category="<%= cat.slug %>"
                  data-veg="<%= d.veg %>"
                  data-spice="<%= d.spice %>">
                  <div class="menu-item__art <%= d.veg ? 'sw-curry' : 'sw-chili' %>">
                    <span class="dish-card__veg <%= d.veg ? 'is-veg' : 'is-nonveg' %>" title="<%= d.veg ? 'Vegetarian' : 'Non-Vegetarian' %>"></span>
                    <span><%= d.icon || cat.icon %></span>
                    <% if (d.tags.includes('new')) { %><span class="dish-card__badge dish-card__badge--new">New</span><% } %>
                    <% if (d.tags.includes('chefs-pick')) { %><span class="dish-card__badge dish-card__badge--pick">Chef's Pick</span><% } %>
                  </div>
                  <div class="menu-item__body">
                    <div class="menu-item__row">
                      <h3><%= d.name %></h3>
                      <span class="menu-item__price">$<%= d.price.toFixed(2) %></span>
                    </div>
                    <p><%= d.description %></p>
                    <div class="menu-item__foot">
                      <span class="spice-meter" aria-label="Spice level">
                        <% for(let s=1;s<=3;s++){ %><span class="spice-flame <%= s<=d.spice ? 'is-lit':'' %>">🔥</span><% } %>
                        <% if (d.spice === 0) { %><em class="mild-label">Mild</em><% } %>
                      </span>
                      <div class="stepper" data-id="<%= d.slug %>" data-name="<%= d.name %>" data-price="<%= d.price %>">
                        <button class="stepper__btn" data-action="dec" aria-label="Remove one <%= d.name %>">–</button>
                        <span class="stepper__count">0</span>
                        <button class="stepper__btn" data-action="inc" aria-label="Add one <%= d.name %>">+</button>
                      </div>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
          <% } %>
        <% }) %>
      </div>

      <!-- Sticky tiffin sidebar -->
      <aside class="tiffin-sidebar" data-reveal data-reveal-delay="1">
        <div class="tiffin-sidebar__inner">
          <h3>Your Order <span class="tiffin-sidebar__count" id="sidebarCount">0 items</span></h3>
          <div class="tiffin-sidebar__items" id="sidebarItems">
            <p class="tiffin-sidebar__empty" id="sidebarEmpty">Tap “+” on any dish to start building your order.</p>
          </div>
          <div class="tiffin-sidebar__total">
            <span>Subtotal</span>
            <strong id="sidebarTotal">$0.00</strong>
          </div>
          <a href="<%= site.doordash %>" target="_blank" rel="noopener" class="btn btn--primary btn--block">Checkout on DoorDash</a>
          <a href="<%= site.ubereats %>" target="_blank" rel="noopener" class="btn btn--outline btn--block">Checkout on Uber Eats</a>
          <a href="tel:<%= site.phone.replace(/[^0-9]/g,'') %>" class="btn btn--ghost btn--block">Or call — <%= site.phone %></a>
          <button class="text-link tiffin-sidebar__clear" id="clearTiffin">Clear order</button>
        </div>
      </aside>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js?v=<%= assetVersion %>"></script>
<script src="/js/menu.js?v=<%= assetVersion %>"></script>
</body>
</html>