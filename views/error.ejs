<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="page-error">
<%- include('partials/header') %>
<main>
  <section class="section not-found">
    <div class="wrap">
      <p class="not-found__icon"><%= statusCode === 404 ? '🫓' : '🔥' %></p>
      <h1><%= statusCode === 404 ? "This plate's empty." : "Something got a little too spicy." %></h1>
      <p><%= message %></p>
      <div class="hero__cta">
        <a href="/" class="btn btn--primary btn--large">Back Home</a>
        <a href="/menu" class="btn btn--outline btn--large">View Menu</a>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
