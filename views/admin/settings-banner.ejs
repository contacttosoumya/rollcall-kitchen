<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('partials/nav') %>
  <main class="admin-main">
    <%- include('partials/topbar') %>
    <div class="admin-content">
      <form class="a-form" method="POST" action="/admin/settings/banner">
        <div class="a-field">
          <label class="a-checkbox"><input type="checkbox" name="enabled" <%= banner.enabled ? 'checked' : '' %>> Show this banner site-wide</label>
        </div>
        <div class="a-field">
          <label>Message</label>
          <textarea name="message"><%= banner.message || '' %></textarea>
        </div>
        <div class="a-field-row">
          <div class="a-field"><label>Button Text (optional)</label><input type="text" name="ctaText" value="<%= banner.ctaText || '' %>"></div>
          <div class="a-field"><label>Button Link (optional)</label><input type="text" name="ctaUrl" value="<%= banner.ctaUrl || '' %>"></div>
        </div>
        <div class="a-form-actions">
          <button type="submit" class="a-btn a-btn--primary">Save Changes</button>
          <a href="/admin/settings" class="a-btn">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
</body>
</html>
